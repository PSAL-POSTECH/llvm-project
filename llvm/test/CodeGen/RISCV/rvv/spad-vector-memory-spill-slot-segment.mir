# A segment register group spilled under spad-vector-memory is split into
# whole-register stores and loads at the group's offsets inside the function's
# scratchpad area, as it is on the stack without the feature.
# RUN: llc -mtriple=riscv64 -mattr=+v,+zvl256b,+spad-vector-memory \
# RUN:   -riscv-v-vector-bits-max=256 -start-before=greedy \
# RUN:   -stop-after=prologepilog %s -o - | FileCheck %s

# CHECK: @segment_spill.vspill = internal addrspace(1) global [96 x i8] zeroinitializer, section ".spad", align 32
# CHECK-LABEL: name: segment_spill
# CHECK:      $x11 = AUIPC target-flags(riscv-got-hi) @segment_spill.vspill
# CHECK-NEXT: $x11 = LD killed $x11, target-flags(riscv-pcrel-lo)
# CHECK-NEXT: VS2R_V $v0m2, $x11, implicit $v0_v1_v2 :: (store {{.*}} into @segment_spill.vspill, {{.*}}addrspace 1)
# CHECK-NEXT: $x12 = ADDI $x0, 64
# CHECK-NEXT: $x11 = ADD killed $x11, killed $x12
# CHECK-NEXT: VS1R_V $v2, killed $x11, implicit $v0_v1_v2 :: (store {{.*}} into @segment_spill.vspill, addrspace 1)
# CHECK:      $x11 = AUIPC target-flags(riscv-got-hi) @segment_spill.vspill
# CHECK-NEXT: $x11 = LD killed $x11, target-flags(riscv-pcrel-lo)
# CHECK-NEXT: $v7 = VL1RE8_V $x11 :: (load {{.*}} from @segment_spill.vspill, addrspace 1)
# CHECK-NEXT: $x12 = ADDI $x0, 32
# CHECK-NEXT: $x11 = ADD killed $x11, killed $x12
# CHECK-NEXT: $v8m2 = VL2RE8_V killed $x11 :: (load {{.*}} from @segment_spill.vspill, {{.*}}addrspace 1)

--- |
  define void @segment_spill(ptr addrspace(1) %base, i64 %vl) {
    ret void
  }
...
---
name:    segment_spill
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, offset: 0, size: 24, alignment: 8, stack-id: scalable-vector }
body: |
  bb.0:
    liveins: $x10, $x11

    %0:gpr = COPY $x10
    %1:gprnox0 = COPY $x11
    $v0_v1_v2 = PseudoVLSEG3E64_V_M1 undef $v0_v1_v2, %0, %1, 6, 0 :: (load (<vscale x 3 x s64>) from %ir.base, addrspace 1)
    PseudoVSPILL3_M1 killed renamable $v0_v1_v2, %stack.0 :: (store (<vscale x 3 x s64>) into %stack.0, align 8)
    renamable $v7_v8_v9 = PseudoVRELOAD3_M1 %stack.0 :: (load (<vscale x 3 x s64>) from %stack.0, align 8)
    VS1R_V killed $v8, %0:gpr :: (store (<vscale x 1 x s64>) into %ir.base, addrspace 1)
    PseudoRET
...
